# 复制为 .env 并填写真实配置
DEEPSEEK_API_KEY=sk-在这里填写你的APIKey
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# 负责“搜公司官网 / 搜B站视频”等检索型任务的 Agent 所用模型(公司推荐、岗位检索、学习计划、证书资源)
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# 竞赛学习(闯关)模式:内置知识库(远程资料包)与 iLab-x 公用账号
# 账号密码用于闯关路径给用户登录 iLab-x,可按需修改;留空则使用内置公用账号
COMPETITION_KB_BASE=http://47.92.219.134:8888
ILAB_ACCOUNT=
ILAB_PASSWORD=

# 增强搜索(Anspire AI Search)
ANSPIRE_API_KEY=sk-在这里填写你的AnspireKey
ANSPIRE_API_URL=https://plugin.anspire.cn/api/ntsearch/search
ANSPIRE_TIMEOUT=30

# 联网搜索主引擎:baidu(默认,国内可访问)/ bing / duckduckgo / anspire
# 失败时会自动依次回退,无需改动
SEARCH_ENGINE=baidu

# free-search-mcp(集成自 https://github.com/sweetcornna/free-search-mcp)回退搜索用的引擎
# 需先安装隔离环境:python -m venv .venv-search && .venv-search\Scripts\pip install free-search-mcp
# 引擎用逗号分隔;默认 baidu,bing,duckduckgo(兼顾国内可访问性)
FREE_SEARCH_ENGINES=baidu,bing,duckduckgo
# 是否启用“DeepSeek 自带联网搜索”作为 verified_search 的第三级回退。
# 1(开启):DeepSeek 端点/模型需支持 web_search 工具才能生效;若端点不支持,该级会被自动跳过并记录。
DEEPSEEK_WEB_SEARCH=1

# find_recruitment_links(招聘入口发现)内部搜候选链接的策略:
#   留空/自动(默认):先快速 web_search,若结果不达标(全是百科/信息聚合/无关/空标题)再自动升级 verified_search。
#   招聘平台(mokahr/hotjob/51job)、品牌目录站、行业门户等都会作为候选输出。
#   1 / on / always = 强制走 verified_search(更可信但更慢)。
#   0 / off / never = 只用 web_search(最快,不做真实性升级)。
# 默认无需设置。
FIND_RECRUIT_USE_VERIFIED=

# 竞赛知识库 Excel 文件路径(证书资料输出后进入“竞赛推荐”环节时使用)
COMPETITION_XLSX=D:/大学生工科竞赛榜单.xlsx

# 图书搜索/下载(z-library 镜像站)
ZBOOK_BASE_URL=https://zh.101k.by
ZBOOK_INDEX_URL=https://znew.pages.dev/
ZBOOK_SHARED_ACCOUNT_URL=https://readzn.com/zlibrary-shared-account
BOOK_SEARCH_MODEL=deepseek-v4-flash-vision-exp
BOOK_TIMEOUT=25
# 浏览器:搜索用 AGENT_BROWSER_PATH 指定 Edge;下载用 BOOK_BROWSER_CHANNEL=msedge
AGENT_BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
BOOK_BROWSER_CHANNEL=msedge

# Agent 动态渲染(Playwright)所用浏览器通道:msedge / chrome
AGENT_BROWSER_CHANNEL=msedge

# PDF 识别(本机完整版 MinerU CLI):已随项目环境安装
# 首次本地解析前需下载模型(见 README),完成后完全离线解析、无需 token
# local=直接用 mineru.json 的 models-dir.pipeline 读本地模型,不联网不加锁(推荐,离线)
# 若 model_dir 尚未配置,可临时用 modelscope/huggingface;国内建议 modelscope(需联网校验)
MINERU_MODEL_SOURCE=local
# 8GB 显卡(且常被其它程序占用)建议设为 4,让 MinerU 以 batch_ratio=1 处理,避免 GPU 显存不足(OOM)
MINERU_VIRTUAL_VRAM_SIZE=4
MINERU_TIMEOUT=1200
